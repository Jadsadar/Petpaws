# คัดลอกเป็น .env (ไว้ข้างๆ docker-compose.prod.yml บน VPS) แล้วแก้ค่าจริง
# ห้าม commit ไฟล์ .env จริงเข้า git เด็ดขาด — ตัวจริงจะเข้ารหัสด้วย SOPS แล้วให้
# Ansible ถอดรหัส deploy ให้ (ยังไม่ได้ตั้ง SOPS ตอนนี้)

# ---------- PostgreSQL ----------
POSTGRES_USER=petpaws
POSTGRES_PASSWORD=CHANGE_ME_ใช้ค่าสุ่มจริงตอน production
POSTGRES_DB=petpaws
DATABASE_URL=postgresql://petpaws:CHANGE_ME_ใช้ค่าสุ่มจริงตอน production@postgres:5432/petpaws

# ---------- Redis ----------
REDIS_MAXMEMORY=256mb
# คิวงาน BullMQ (api + worker) — ชี้เข้า container ชื่อ redis ในเครือข่ายเดียวกัน
# ขาดตัวนี้ API จะ boot ไม่ขึ้น (env.validation.ts บังคับไว้)
REDIS_URL=redis://redis:6379

# ---------- MinIO ----------
MINIO_ROOT_USER=petpaws_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_ใช้ค่าสุ่มจริงตอน production

# ---------- JWT ----------
# generate ใหม่ทุกตัวด้วย: openssl rand -base64 48 — ห้ามใช้ค่าที่เคยใช้ตอน dev เด็ดขาด
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- Object storage (ชี้เข้า MinIO container ชื่อ minio ในเครือข่ายเดียวกัน) ----------
S3_ENDPOINT=http://minio:9000
S3_REGION=ap-southeast-1
S3_BUCKET=petpaws-media
S3_ACCESS_KEY_ID=petpaws_minio
S3_SECRET_ACCESS_KEY=CHANGE_ME_ใช้ค่าสุ่มจริงตอน production
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_URL_TTL=900

# ---------- Firebase Cloud Messaging (เฉพาะ push, ไม่ใช้ auth) ----------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---------- NestJS API ----------
API_PORT=3000
# จำกัดให้เหลือแค่โดเมนจริงของแอป ห้ามปล่อย * ตอน production
CORS_ORIGIN=https://your-domain-here

# ---------- Caddy ----------
# ตอนยังไม่มีโดเมน ปล่อยว่างไว้ได้ (Caddyfile จะ fallback ไปใช้ IP แทน)
PETPAWS_DOMAIN=
