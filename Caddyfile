# ตอนยังไม่มีโดเมนจริง PETPAWS_DOMAIN ว่าง → docker-compose.prod.yml ส่ง ":80" เข้ามา
# (รับทุก Host แบบ HTTP ไม่มี HTTPS เพราะ Caddy ออกใบรับรองให้ IP ไม่ได้)
# พอมีโดเมนแล้วตั้ง PETPAWS_DOMAIN ใน .env เป็นชื่อโดเมนจริง (เช่น api.petpaws.app)
# แล้ว restart caddy ใหม่ Caddy จะออก HTTPS ให้อัตโนมัติเอง ไม่ต้องแก้ไฟล์นี้เพิ่ม
#
# หมายเหตุ: fallback ในไฟล์นี้ใช้จริงเฉพาะตอนรัน caddy ตรงๆ โดยไม่ผ่าน compose
{$PETPAWS_DOMAIN::80} {
	encode gzip

	# รูป/วิดีโอ: แอปโหลดและอัปตรงมาที่ path ของ bucket (S3_PUBLIC_ENDPOINT ชี้มาที่โดเมนนี้)
	# แล้วส่งต่อให้ MinIO ภายใน — ไม่ต้องเปิด port 9000 ออกอินเทอร์เน็ต
	# ชื่อ bucket ต้องตรงกับ S3_BUCKET ใน .env (ค่าเริ่มต้น petpaws-media)
	#
	# ต้องรับ "/petpaws-media" แบบไม่มี / ท้ายด้วย: presigned POST ของแชท (อัปรูป/วิดีโอ)
	# ยิงไปที่ URL ของ bucket ตรง ๆ ซึ่ง AWS SDK สร้างมาไม่มี / ท้าย — ถ้าจับแค่ /petpaws-media/*
	# คำขออัปจะหลุดไปเข้า API แล้วได้ 404 (ส่งรูป/วิดีโอในแชทไม่ได้ทั้งหมด)
	@media path /petpaws-media /petpaws-media/*
	handle @media {
		reverse_proxy petpaws-minio:9000
	}

	# API สองตัว (docker-compose.prod.yml: api, api-2) — Caddy เป็น load balancer
	handle {
		reverse_proxy petpaws-api:3000 petpaws-api-2:3000 {
			# ส่งให้ตัวที่มีงานค้างน้อยกว่า — WebSocket ถือการเชื่อมต่อค้างนาน แบ่งตามจำนวนจริงดีกว่าสลับกันไปทีละคำขอ
			lb_policy least_conn
			# ตัวหนึ่งกำลัง restart (deploy) ต่อไม่ติด = ลองอีกตัวภายใน 5 วิ ผู้ใช้ไม่เห็น error
			lb_try_duration 5s
			lb_try_interval 250ms
			# เช็กทุก 5 วิ ตัวไหนไม่ตอบถอดออกจนกว่าจะกลับมา — /health/live ไม่แตะ DB
			# (DB สะดุดแป๊บเดียวจะได้ไม่ถอด API ทุกตัวพร้อมกัน)
			health_uri /health/live
			health_interval 5s
			health_timeout 2s
		}
	}
}
