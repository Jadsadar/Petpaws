# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
# ห้าม commit ไฟล์ .env เข้า git เด็ดขาด

# ---------- PostgreSQL ----------
POSTGRES_USER=petpaws
POSTGRES_PASSWORD=petpaws_dev_password
POSTGRES_DB=petpaws
POSTGRES_PORT=5432

DATABASE_URL=postgresql://petpaws:petpaws_dev_password@localhost:5432/petpaws

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
REDIS_URL=redis://localhost:6379

# Redis ตัวแยกสำหรับ cache (service redis-cache) — ลบบรรทัด URL ทิ้งได้ถ้าอยากปิด cache ตอน dev
REDIS_CACHE_PORT=6380
REDIS_CACHE_MAXMEMORY=64mb
REDIS_CACHE_URL=redis://localhost:6380

# ---------- เครื่องมือตอน dev ----------
ADMINER_PORT=8080

# ---------- MinIO (object storage สำหรับ dev, พูด S3 API เดียวกัน) ----------
MINIO_ROOT_USER=petpaws_minio
MINIO_ROOT_PASSWORD=petpaws_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- JWT ----------
# สร้างค่าใหม่ด้วย: openssl rand -base64 48
# ต้องใช้คนละ secret กันระหว่าง access กับ refresh
# ถ้าใช้ secret เดียวกัน refresh token จะถูกเอาไปใช้เป็น access token ได้
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- Object storage (S3 / MinIO) ----------
# ค่าเริ่มต้นชี้ไปที่ MinIO ใน docker-compose สำหรับ dev
# ตอนขึ้น production ให้เปลี่ยน S3_ENDPOINT เป็นของจริง (S3/R2/Spaces) แล้วใส่คีย์จริง
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=petpaws-media
S3_ACCESS_KEY_ID=petpaws_minio
S3_SECRET_ACCESS_KEY=petpaws_minio_password
# บังคับ path-style URL (http://endpoint/bucket/key) ซึ่ง MinIO ต้องการ
# S3 จริงใช้ virtual-hosted style ได้ ตั้งเป็น false ตอน deploy จริง
S3_FORCE_PATH_STYLE=true
# อายุของ presigned URL สำหรับอัปโหลด (วินาที)
S3_UPLOAD_URL_TTL=900

# ---------- Firebase Cloud Messaging ----------
# ใช้เฉพาะส่งแจ้งเตือน ไม่ได้ใช้ทำ authentication
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---------- NestJS API (backend/api) ----------
API_PORT=3000
# origin ของ Flutter web ตอน dev (flutter run -d chrome สุ่ม port ทุกครั้ง
# เลยเปิดกว้างไว้ก่อนตอน dev เท่านั้น — จำกัดให้แคบลงตอน deploy จริง)
CORS_ORIGIN=*
