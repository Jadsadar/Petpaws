# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android build/signing — local.properties มี path SDK เฉพาะเครื่อง, key.properties
# กับ *.keystore/*.jks เป็นรหัสผ่าน/คีย์เซ็นแอปจริง ห้ามหลุดขึ้น git เด็ดขาด
**/android/local.properties
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/**/key.properties
**/android/**/*.keystore
**/android/**/*.jks
**/ios/**/*.mobileprovision
**/ios/**/*.p12

# Backend secrets — .env มีรหัสผ่าน DB / JWT secret / คีย์ S3 ห้ามหลุดขึ้น git เด็ดขาด
backend/.env
backend/.env.local
backend/api/.env
backend/api/.env.*
!backend/api/.env.example

# .env จริงของ production (คู่กับ docker-compose.prod.yml) ห้ามหลุดขึ้น git เช่นกัน
/.env
!/.env.production.example

# Node / NestJS (backend/api) — 163MB+ ถ้า node_modules หลุดขึ้นไปจะดึง repo ช้ามาก
# และ dist/ generate ใหม่ได้จาก source เสมอ ไม่มีเหตุผลต้อง commit
**/node_modules/
backend/api/dist/
backend/api/dist-worker/
backend/api/build/
backend/api/coverage/
backend/api/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Docker volumes ถูก mount ผ่าน docker-compose อยู่แล้ว ไม่ควรมีไฟล์ data ค้างในซอร์ส
backend/db/pgdata/
backend/db/miniodata/

# กันคีย์/credential ทุกชนิดหลุดขึ้น git แบบครอบคลุมทั้ง repo (defense in depth —
# เผื่อใครก็อปคีย์มาวางผิดที่ ไม่ใช่แค่ path ที่คาดไว้ข้างบน)
*.pem
*.ppk
id_rsa*
id_ed25519*
*.age
age.key
*.gpg
*.asc
.aws/
.npmrc
.netrc
credentials.json
service-account*.json
*-service-account.json

# Jenkins agent binary — download from <jenkins-url>/jnlpJars/agent.jar
agent.jar
